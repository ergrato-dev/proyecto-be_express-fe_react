# ============================================================
# Variables de entorno para los TESTS del backend
# Copia este archivo como be/.env.test (está en .gitignore).
# ============================================================
# BD exclusiva para tests: servicio db-test del docker-compose (puerto 5433).
#   docker compose up -d --wait db-test
# Los tests se detienen si el nombre de la BD no termina en _test.
NODE_ENV=test
DATABASE_URL=postgresql://nn_user:nn_password@localhost:5433/nn_auth_test

# Valores de prueba, nunca los de producción (mínimo 32 caracteres).
JWT_ACCESS_SECRET=test-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=test-refresh-secret-at-least-32-characters
