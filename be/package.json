{
  "name": "nn-auth-be",
  "version": "1.0.0",
  "description": "NN Auth System — Backend Express.js + TypeScript + PostgreSQL",
  "main": "dist/index.js",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "bcryptjs": "2.4.3",
    "cors": "2.8.6",
    "dotenv": "16.6.1",
    "express": "5.2.1",
    "express-rate-limit": "7.5.1",
    "helmet": "8.1.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "9.0.5",
    "pg": "8.20.0",
    "prisma": "7.9.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "20.19.39",
    "@types/nodemailer": "7.0.11",
    "@types/pg": "8.20.0",
    "@types/supertest": "6.0.3",
    "@vitest/coverage-v8": "4.1.2",
    "eslint": "9.39.4",
    "prettier": "3.8.1",
    "supertest": "7.2.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.2.1",
    "vitest": "4.1.2"
  }
}
